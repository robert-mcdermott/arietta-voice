include conftest.py uv.lock .python-version
include CHANGELOG.md ROADMAP.md
recursive-include docs *.md
recursive-include tests *.py
recursive-include evals *.py *.json *.md
recursive-include bench *.py *.txt *.md
recursive-include scripts *.py
prune config
prune knowledge
prune logs
prune .knowledge_index
prune tmp
prune models
prune tools
global-exclude *.local.toml *.local.md *.admin.json *.working *.bak .DS_Store
