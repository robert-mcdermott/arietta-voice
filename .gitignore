# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local runtime artifacts
logs/
.knowledge_index/
config/MEMORY.md
/config/*.local.toml
/config/*.local.toml.lock
/config/*.local.md
/config/*.admin.json
/config/.private-backups/
/config/*.working
# Incomplete atomic writes must remain private after an interrupted process.
/config/.*.local.*
/config/.*.admin.json.*
tmp/

# Keep personal knowledge local; only the two starter documents belong in Git.
/knowledge/*
!/knowledge/README.md
!/knowledge/getting-started.md

# macOS metadata
.DS_Store
